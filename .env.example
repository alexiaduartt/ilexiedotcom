# Server only. Groq is the default; no automatic paid fallback.
ASK_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative, used ONLY with ASK_AI_PROVIDER=openai.
# Server only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Choose a Responses API text model available in your account.
OPENAI_MODEL=
# Optional: set to none only for a model that supports reasoning.effort=none.
OPENAI_REASONING_EFFORT=
# Optional shared Redis REST service (Upstash-compatible), required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret used to hash IP addresses; required in production.
ASK_RATE_LIMIT_SECRET=
# Maximum accepted requests per UTC day, shared across all visitors.
ASK_DAILY_REQUEST_LIMIT=100
# Per IP in a fixed 60-second window (maximum 60).
ASK_REQUESTS_PER_MINUTE=6
# Per IP in a short fixed window; protects against bursts (maximum 10).
ASK_BURST_REQUEST_LIMIT=2
ASK_BURST_WINDOW_SECONDS=10
# Shared across all visitors in a fixed 60-second window (maximum 60).
ASK_GLOBAL_REQUESTS_PER_MINUTE=3
